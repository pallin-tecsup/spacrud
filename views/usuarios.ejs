<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios registrados</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 25px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 12px;
            text-align: left;
        }

        th {
            background: #e9eef5;
        }

        form {
            display: inline;
        }
    </style>
</head>
<body>

    <h1>Usuarios registrados</h1>

    <h2>Registrar usuario</h2>

<form action="/validar" method="POST">
    <input
        type="text"
        name="dni"
        placeholder="DNI"
        minlength="8"
        maxlength="8"
        pattern="[0-9]{8}"
        required
    >

    <input
        type="text"
        name="nombres"
        placeholder="Nombres"
        required
    >

    <input
        type="email"
        name="correo"
        placeholder="Correo electrónico"
        required
    >

    <input
        type="password"
        name="password"
        placeholder="Contraseña"
        required
    >

    <button type="submit">Agregar usuario</button>
</form>

    <table>
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombres</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% usuarios.forEach(function(usuario) { %>
                <tr>
                    <td><%= usuario.dni %></td>
                    <td><%= usuario.nombres %></td>
                    <td><%= usuario.correo %></td>
                    <td>
                        <a href="/editar/<%= usuario.dni %>">
                            Editar
                        </a>

                        <form
                            action="/eliminar/<%= usuario.dni %>"
                            method="POST"
                            onsubmit="return confirm('¿Deseas eliminar este usuario?')"
                        >
                            <button type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

</body>
</html>